      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${mysqlDatasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \r\n    j.id_job as \"jobid\",\r\n    j.job_name,\r\n    j.`partition`,\r\n    a.`user` as \"user\",\r\n    j.nodelist,\r\n    j.nodes_alloc,\r\n    j.cpus_req,\r\n    CASE (j.state & 0xff)\r\n        WHEN 0 THEN 'PENDING'\r\n        WHEN 1 THEN 'RUNNING'\r\n        WHEN 2 THEN 'SUSPENDED'\r\n        WHEN 3 THEN 'COMPLETED'\r\n        WHEN 4 THEN 'CANCELLED'\r\n        WHEN 5 THEN 'FAILED'\r\n        WHEN 6 THEN 'TIMEOUT'\r\n        WHEN 7 THEN 'NODE_FAIL'\r\n        WHEN 8 THEN 'PREEMPTED'\r\n        WHEN 9 THEN 'BOOT_FAIL'\r\n        WHEN 10 THEN 'DEADLINE'\r\n        WHEN 11 THEN 'OUT_OF_MEMORY'\r\n        ELSE 'UNKNOWN'\r\n    END as \"state\",\r\n   \r\n    FROM_UNIXTIME(j.time_submit) as \"submit_time\",\r\n    FROM_UNIXTIME(j.time_start) as \"start_time\"\r\nFROM \r\n    ${cluster_db}.`${slurm_cluster}_job_table` j\r\nLEFT JOIN \r\n    ${cluster_db}.`${slurm_cluster}_assoc_table` a ON j.id_assoc = a.id_assoc\r\nWHERE \r\n    (j.state & 0xff) = 1\r\n    AND $__unixEpochFilter(j.time_start)\r\n    AND j.`partition` IN (${partition:singlequote})\r\nORDER BY \r\n    j.time_start DESC\r\nLIMIT 1000",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [
                  {
                    "name": "time_start",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
